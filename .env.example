# Copia este archivo como .dev.vars (está en .gitignore) para desarrollo local.
# En producción estas variables van en: YaDominios Cloud → tu sitio → Variables de entorno.

# Obligatoria. Secreto largo y aleatorio (mínimo 32 caracteres). Firma CSRF,
# pimienta de contraseñas y hash de IP. Generar con: openssl rand -base64 48
APP_SECRET=

# Dirección pública del sitio, sin barra final.
APP_URL=http://localhost:3000

# Opcional: escudo anti-robots de Cloudflare Turnstile. Sin las dos, se apaga solo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: avisos por SMS (Twilio). Sin estas, los SMS quedan «no configurado» en /datos/salud.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Opcional: remitente del correo saliente (requiere dominio propio en YaDominios Cloud).
EMAIL_FROM=

# Recomendada: correo de soporte que se publica en /privacidad y /terminos.
SUPPORT_EMAIL=

# Obligatoria en producción: secreto que usa el reloj externo para llamar /datos/reloj.
RELOJ_SECRETO=

# Obligatoria en producción: clave AES-256 en base64 (32 bytes) para cifrar respaldos.
# Generar con: openssl rand -base64 32
BACKUP_KEY=
