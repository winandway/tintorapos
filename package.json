{
  "name": "tintora-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:local": "node scripts/db-local.mjs",
    "demo:local": "node scripts/demo-local.mjs",
    "check:env": "node scripts/check-env.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:bundle": "node scripts/empaquetar-worker.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "audit": "npm audit --audit-level=high",
    "secrets": "gitleaks git --no-banner --redact .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit && npm run secrets",
    "prepare": "husky",
    "test:paquete": "node scripts/probar-paquete.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "jsqr": "^1.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "miniflare": "^5.20260915.0-alpha",
    "msw": "^2.15.0",
    "prettier": "^3.9.7",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "engines": {
    "node": ">=22"
  }
}
